+void MeshMap::meshGeometryCallback(const mesh_msgs::msg::MeshGeometryStamped::ConstSharedPtr& msg)
+{
+  RCLCPP_INFO(
+    node->get_logger(),
+    "Received a streamed mesh update (%zu vertices, %zu faces). Reloading map...",
+    msg->mesh_geometry.vertices.size(), msg->mesh_geometry.faces.size());
+
+  lvr2::MeshBufferPtr mesh_buffer;
+  if (!mesh_msgs_conversions::fromMeshGeometryToMeshBuffer(msg->mesh_geometry, mesh_buffer))
+  {
+    RCLCPP_ERROR(node->get_logger(), "Failed to convert the streamed mesh to a mesh buffer -- ignoring update.");
+    return;
+  }
+
+  // Its own working file, not mesh_working_file directly, so a bad update can't corrupt
+  // the file a subsequent restart would load from.
+  const std::string streamed_working_file =
+    (fs::path(mesh_working_file).parent_path() / "mesh_map_streamed.h5").string();
+  if (!mesh_msgs_conversions::writeMeshBuffer(mesh_buffer, streamed_working_file))
+  {
+    RCLCPP_ERROR(
+      node->get_logger(), "Failed to write the streamed mesh to '%s' -- ignoring update.",
+      streamed_working_file.c_str());
+    return;
+  }
+
+  // Same load path a file-based (re)start uses: readMap() only opens mesh_io_ptr when it
+  // is null, so resetting it here (rather than duplicating everything readMap() already
+  // does) is what makes it pick up the new file instead of a no-op.
+  mesh_file = streamed_working_file;
+  mesh_working_file = streamed_working_file;
+  mesh_io_ptr.reset();
+
+  if (!readMap())
+  {
+    RCLCPP_ERROR(node->get_logger(), "Failed to reload the map from the streamed mesh.");
+  }
+}
