#!/usr/bin/env bash
# Pixi-managed dev environment (replaces the former Nix flake dev shell).
# Re-runs the shell-hook whenever the manifest or lockfile changes.
watch_file pixi.toml pixi.lock

if has pixi; then
  eval "$(pixi shell-hook --environment default)"
else
  echo "pixi not found — install from https://pixi.sh then re-run direnv" >&2
fi
